{
  "name": "conecta-vera-cruz",
  "compatibility_date": "2026-08-05",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/avaliacao-historia/api/*",
      "/api/avaliacoes/*"
    ]
  },
  "main": "atlas-backend/worker.js",
  "durable_objects": {
    "bindings": [
      {
        "name": "ATLAS_HISTORIA",
        "class_name": "AtlasHistoria"
      }
    ]
  },
  "migrations": [
    {
      "tag": "atlas-historia-v1",
      "new_sqlite_classes": [
        "AtlasHistoria"
      ]
    }
  ]
}
